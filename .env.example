# IBKR Flex Web Service Credentials
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Your Flex Web Service Token (from Account Management > Settings > Flex Web Service)
IBKR_FLEX_TOKEN=your_flex_token_here

# Your Flex Query ID (from Account Management > Reports > Flex Queries)
IBKR_QUERY_ID=your_query_id_here
